float _sk_hue(vec2 ab) { return mod(degrees(atan(ab.y, ab.x)) + 360.0, 360.0); }

// In log-odds q the hue flow primitive is 2*(sinh(q)+q).
// Two Halley steps solve for the positive root z=exp(abs(q)).
float _sk_flow(float hue, float time) {
    if (hue <= 45.0 || hue >= _SKM_YELLOW_HUE || time == 0.0)
        return hue;
    float span = _SKM_YELLOW_HUE - 45.0;
    float u = clamp((hue - 45.0) / span, 1e-7, 1.0 - 1e-7);
    float odds = u / (1.0 - u);
    float goal = odds - 1.0 / odds + 2.0 * log(odds) + time;
    float magnitude = abs(goal);
    float z = .5 * magnitude + sqrt(1.0 + .25 * magnitude * magnitude);
    for (int i = 0; i < 2; ++i) {
        float inverse = 1.0 / z;
        float slope = 1.0 + inverse;
        float residual = z - inverse + 2.0 * log(z) - magnitude;
        z -= residual / (slope * slope + residual / (z * (z + 1.0)));
    }
    float mapped = (goal > 0.0 ? z : 1.0) / (1.0 + z);
    return 45.0 + span * mapped;
}

float _sk_inverseShear(float x, float shifted, float weight) {
    float p = max(x, 0.0);
    float k = 4.0 * weight * p * p / (.05 * .05 + p * p);
    if (shifted <= 0.0 || k <= 0.0)
        return shifted;
    float b = .05 - shifted;
    float disc = sqrt(b * b + 4.0 * (1.0 + k) * .05 * shifted);
    return b >= 0.0 ? .1 * shifted / (disc + b) : (disc - b) / (2.0 * (1.0 + k));
}

float _sk_coneRayLimit(vec3 d, vec3 low, vec3 high) {
    vec3 distances = vec3(1e30);
    for (int c = 0; c < 3; ++c) {
        if (d[c] != 0.0)
            distances[c] = (d[c] < 0.0 ? low[c] : high[c]) / d[c];
    }
    return max(min(distances.x, min(distances.y, distances.z)), 0.0);
}

float _sk_atlas(vec2 texel) { return textureLod(usam_skibidiAux, (texel + 0.5) / _SKM_ATLAS_SIZE, 0.0).r; }

float _sk_reachSeed(float r, float weight, float hue, bool warm, bool transported) {
    float level = log2(1.0 + 0.25 * r) / log2(101.0);
    if (transported && hue >= 90.0) {
        hue = _sk_flow(hue, -8.0 * weight);
        warm = false;
    }
    vec2 texel;
    if (warm) {
        float row = (transported ? _SKM_FLOW_FIELD.y : _SKM_SHEAR_FIELD.y) + _SKM_FLOW_FIELD.w * level;
        float pivot = 90.0 * _sk_atlas(vec2(_SKM_WARM_JOIN_FIELD.x, row));
        float sector = hue <= pivot ? hue / pivot : 1.0 + (hue - pivot) / (90.0 - pivot);
        texel = vec2(_SKM_FLOW_FIELD.x + (.5 * _SKM_FLOW_FIELD.z) * sector, row);
    } else {
        float col = _SKM_SOURCE_FIELD.x + _SKM_SOURCE_FIELD.z * level;
        float red = 360.0 * _sk_atlas(vec2(col, _SKM_PRIMARIES_FIELD.y)),
              green = 360.0 * _sk_atlas(vec2(col, _SKM_PRIMARIES_FIELD.y + 1.0));
        float sector;
        if (hue >= red && hue < green) {
            sector = (hue - red) / (green - red);
        } else {
            float blue = 360.0 * _sk_atlas(vec2(col, _SKM_PRIMARIES_FIELD.y + 2.0));
            sector = hue >= green && hue < blue
                         ? 1.0 + (hue - green) / (blue - green)
                         : 2.0 + ((hue < red ? hue + 360.0 : hue) - blue) / (red + 360.0 - blue);
        }
        texel = vec2(col, (_SKM_SOURCE_FIELD.w / 3.0) * sector);
    }
    return 2.0 * r * (1.0 - r / 400.0) * _sk_atlas(texel);
}


vec2 _sk_shear(float h, float radius, float r, float w) {
    vec2 ab = _sk_direction(h) * radius;
    float x = max(ab.x / r, 0.0), y = max(ab.y / r, 0.0);
    float gain = 4.0 * w * x * x / (.05 * .05 + x * x);
    ab.y += r * gain * y * y / (y + .05);
    return vec2(_sk_hue(ab), length(ab));
}
vec2 skRedCusp() {
    vec3 cones = inverse(_SKM_CONES_TO_RGB)[0];
    vec3 aab = _sk_aab(vec3(_sk_response(cones.x), _sk_response(cones.y), _sk_response(cones.z)));
    return vec2(_sk_hue(aab.yz), pow(aab.x / (3.05 * _SKM_PEAK_R), _SKM_CZ));
}

vec2 skPlane(vec3 delta) {
    vec3 axis = normalize(_SKM_DISPLAY_Y) + vec3(1, 0, 0);
    return (delta - (2.0 * dot(axis, delta) / dot(axis, axis)) * axis).yz;
}

float skGeometry(vec2 xy) {
    return persistent_drtGeometry_sample((xy + 0.5) / vec2(145, 81)).r;
}

float _sk_cusp(float hue) {
    float red = skRedCusp().x;
    float sector = hue <= red ? hue / red : 1.0 + (hue - red) / (90.0 - red);
    if (!targetIsRec709()) return skGeometry(vec2(sector * 60.0, 32.0));
    return _sk_atlas(_SKM_CUSP_FIELD.xy + vec2(0.0, (.5 * _SKM_CUSP_FIELD.w) * sector));
}
float _sk_lightnessTarget(float j, float originalHue, float hue, float anchor, float u) {
    float angle = pow(sin(2.0 * radians(hue)), 2.0);
    float envelope = pow(sin(2.0 * radians(hue <= 45.0 ? hue : max(originalHue, 45.0))), 2.0);
    float z = (j - anchor) / (1.0 - anchor), fraction = pow(u, 4.0);
    float strength = 80.0 * fraction / (1.0 + 79.0 * fraction);
    float effect = max(envelope, angle) - angle;
    float factor = exp(-log(16.0) * strength * z * z * (angle + .25 * effect));
    return min(j, anchor + (1.0 - anchor) * z * factor / (1.0 - z + z * factor));
}

vec3 _sk_displayRgb(float r, float y, vec3 direction, float radius) {
    return _SKM_CONES_TO_RGB * (_sk_inverse(vec3(r) + direction * radius) - vec3(y)) + vec3(y / _SKM_PEAK);
}
// Predict all six display-cube face crossings, then refine the first face.
float _sk_displayHalleyStep(float x, float upper, float maxRgb, vec3 rgb, vec3 slope, vec3 curve) {
    vec3 target = mix(vec3(maxRgb), vec3(0.0), lessThan(slope, vec3(0.0)));
    vec3 residual = rgb - target;
    vec3 tangent = x - residual / slope;
    tangent = mix(vec3(1e30), tangent, greaterThanEqual(tangent, vec3(0.0)));
    int face = tangent.x < tangent.y ? 0 : 1;
    face = tangent.z < tangent[face] ? 2 : face;
    float f = residual[face], d = slope[face];
    float next = x - 2.0 * f * d / (2.0 * d * d - f * curve[face]);
    if (!(next >= 0.0 && next <= upper))
        next = tangent[face];
    return clamp(next, 0.0, upper);
}

float _sk_displaySeed(float r, float y, float hue) {
    if (!targetIsRec709()) return skGeometry(vec2(hue * (144.0/360.0), 31.0 * sqrt(y))) * (1.0-r/_SKM_PEAK_R);
    return 4.0 *
           _sk_atlas(vec2(hue * (_SKM_DISPLAY_FIELD.z / 360.0),
                          _SKM_DISPLAY_FIELD.y + _SKM_DISPLAY_FIELD.w * sqrt(y / _SKM_PEAK))) *
           (1.0 - r / _SKM_PEAK_R);
}

float _sk_displayCap(float r, float y, float initialRadius, vec3 direction) {
    float upper = _sk_coneRayLimit(direction, vec3(-r), vec3(_SKM_PEAK_R - r));
    if (upper <= 0.0)
        return 0.0;
    // Relative cones avoid subtracting absolute dark luminances. All lower
    // faces have target zero; the upper faces have target peak/y.
    float q = r / 400.0, p = 1.0 / .42;
    float bound = upper / r, maxRgb = _SKM_PEAK / y;
    mat3 m = _SKM_CONES_TO_RGB * _SKM_PEAK;
    float x = initialRadius;
    vec3 slope, curve;
    // A large first correction near a display primary warrants a second step.
    float seed = x;
    for (int k = 0; k < 2; ++k) {
        vec3 response = 1.0 + x * direction;
        vec3 remaining = 1.0 - q * response;
        vec3 cones = pow(max(response, vec3(0.0)) * (1.0 - q) / remaining, vec3(p));
        vec3 deriv = direction / max(response * remaining, vec3(1e-12));
        vec3 rgb = vec3(1.0) + m * (cones - 1.0);
        slope = m * (p * cones * deriv);
        curve = m * (p * cones * deriv * deriv * (p - 1.0 + 2.0 * q * response));
        x = _sk_displayHalleyStep(x, bound, maxRgb, rgb, slope, curve);
        if (abs(x - seed) <= 0.003 * x)
            break;
    }
    // Reference returns the inward edge after 8 intervals and 18 bisections.
    // Its resolution is upper/2^21, even when the ray's first exit is tiny.
    float units = floor((x / bound) * 2097152.0);
    return units * (upper / 2097152.0);
}

float _sk_allocate(float q, float limit) {
    if (q <= .8)
        return q;
    float e = limit - 1.0, z = sqrt(e * e + .02 * .02);
    float positive = e >= 0.0 ? .5 * (e + z) : .5 * .02 * .02 / (z - e);
    float curvature = positive / (.2 * (.2 + positive)), tail = q - .8;
    return .8 + tail / (1.0 + curvature * tail);
}

float _sk_skinWeight(vec3 rgb) {
    float gb = rgb.g + rgb.b;
    vec2 chromaticity = vec2(rgb.r / (rgb.r + gb), _sk_div(rgb.b, gb));
    return 0.125 * _sk_atlas(_SKM_SKIN_FIELD.xy + _SKM_SKIN_FIELD.zw * chromaticity);
}
vec3 _sk_chromaticSection(vec3 aab, float r, float neutral, float weight, float skin, vec3 sourceRgb,
                          vec3 sourceCone, vec3 response) {
    vec2 sourceAB = aab.yz;
    float sourceRadius = length(sourceAB), sourceHue = _sk_hue(sourceAB);
    bool warm = sourceAB.x > 0.0 && sourceAB.y > 0.0 && weight > 0.0;
    vec2 beforeAB = sourceAB;
    vec2 beforeFlow = vec2(sourceHue, sourceRadius);
    if (warm) {
        float x = sourceAB.x / r, y = sourceAB.y / r;
        beforeAB.y += (4.0 * weight * x * x / (.05 * .05 + x * x)) * y / (y + .05) * sourceAB.y;
        beforeFlow = vec2(_sk_hue(beforeAB), length(beforeAB));
    }

    float neutralR = _sk_response(neutral);
    float j = pow(neutralR / _SKM_PEAK_R, _SKM_CZ);
    float target = j, reach = 0.0, remaining = 0.0;
    if (warm && j > max(_SKM_GRAY_J, skRedCusp().y)) {
        float anchor = max(_SKM_GRAY_J, _sk_cusp(beforeFlow.x));
        if (j > anchor) {
            // The lightness budget uses the pre-transport source section.
            reach = _sk_reachSeed(r, weight, beforeFlow.x, true, false);
            float occupancy = clamp(_sk_div(beforeFlow.y, reach), 0.0, 1.0);
            target = _sk_lightnessTarget(j, sourceHue, beforeFlow.x, anchor, occupancy);
        }
    }
    bool flowed = beforeFlow.x > 45.0 && beforeFlow.x < _SKM_YELLOW_HUE && weight > 0.0;
    vec2 afterFlow = beforeFlow;
    vec2 movedAB = sourceAB;
    float movedHue = sourceHue;
    if (flowed) {
        movedHue = _sk_flow(sourceHue, 8.0 * weight);
        movedAB = _sk_direction(movedHue) * sourceRadius;
        afterFlow = warm ? _sk_shear(movedHue, sourceRadius, r, weight) : vec2(movedHue, sourceRadius);
    }
    float targetR = target < j ? _SKM_PEAK_R * pow(target, 1.0 / _SKM_CZ) : neutralR;
    float targetY = target < j ? _sk_inverse(targetR) : neutral, v = targetY / _SKM_PEAK;
    float lightnessRatio = pow(targetR / r, _SKM_CZ);
    vec2 unit = flowed ? _sk_direction(afterFlow.x) : beforeAB / beforeFlow.y;
    vec3 direction = _SKM_OPP_TO_CONES * unit;
    vec3 outputDirection = _SKM_OPP_TO_CONES * vec2((1.0 - skin) * unit.x, unit.y);

    float displaySeed = _sk_displaySeed(targetR, targetY, afterFlow.x);
    // The baker encloses the whole ray inside the RGB cube up to this fraction.
    // Reserve room for the reference grid and float rounding before the .8 knee.
    float linearLimit = 0.8 * (_SKM_INTERIOR_FRACTION * targetR * displaySeed - 4e-6 * _SKM_PEAK_R);
    bool transported = warm && flowed;
    vec2 section = transported ? afterFlow : beforeFlow;
    if (transported || reach == 0.0)
        reach = _sk_reachSeed(r, weight, section.x, warm, transported);
    remaining = max((reach - section.y) / section.y, 0.0);
    float occupancy = 1.0 / (1.0 + remaining);
    if (target < j) {
        float gray = .18 * _SKM_WHITE / _SKM_PEAK;
        float odds = pow(.18 * _SKM_FL, .42) / 27.13 *
                     pow(((1.0 / gray - 1.0) * v) / max(1.0 - v, 1e-20), .42 * (1.0 - gray));
        float rs = 400.0 * odds / (1.0 + odds);
        float ws = pow(max((v - gray) / (1.0 - gray), 0.0), 2.0);
        lightnessRatio = pow(targetR / rs, _SKM_CZ);
        reach = _sk_reachSeed(rs, ws, afterFlow.x, warm, flowed);
    }
    if (v > .5 && v < 1.0) {
        float t = (v - .5) * 2.0;
        float gate = (1.0 - t) * (1.0 - t) * (1.0 + 2.0 * t);
        occupancy = _sk_div(gate, remaining + gate);
    }
    // Below the knee the chroma allocator returns its argument unchanged.
    float radius = occupancy * (reach * lightnessRatio);
    if (!targetIsRec709() || radius > linearLimit) {
        float cap = _sk_displayCap(targetR, targetY, displaySeed, direction);
        float ratio = _sk_div(reach * lightnessRatio, cap);
        radius = cap * _sk_allocate(occupancy * ratio, ratio);
    }
    return _sk_displayRgb(targetR, targetY, outputDirection, radius);
}

vec3 _sk_si5(vec3 repaired, float powerScale) {
    vec3 cone = max(_SKM_WORK_TO_CONES * repaired, vec3(1e-38));
    vec3 power = powerScale * pow(cone, vec3(.42));
    vec3 response = 400.0 * power / (27.13 + power);
    vec3 aab = _sk_aab(response);
    float r = aab.x / 3.05;
    if (r >= 400.0)
        return vec3(1.0);
    float neutral, w;
    _sk_section(r, neutral, w);
    vec3 rgb = vec3(neutral / _SKM_PEAK);
    float radius = length(aab.yz);
    if (radius > 1e-13 * max(aab.x, 1e-30) && neutral > 0.0 && neutral < _SKM_PEAK) {
        rgb = _sk_chromaticSection(aab, r, neutral, w, _sk_skinWeight(repaired), repaired, cone, response);
    }
    return clamp(rgb, 0.0, 1.0);
}
