float _sk_div(float a, float b) { return b > 0.0 ? a / b : 0.0; }
float _sk_response(float x) {
    float p = pow(_SKM_FL * abs(x), .42);
    return sign(x) * 400.0 * p / (27.13 + p);
}
float _sk_inverse(float x) {
    float a = abs(x);
    return sign(x) * pow(27.13 * a / max(400.0 - a, 1e-20), 1.0 / .42) / _SKM_FL;
}
vec3 _sk_inverse(vec3 x) {
    vec3 a = abs(x);
    return sign(x) * pow(27.13 * a / max(400.0 - a, vec3(1e-20)), vec3(1.0 / .42)) / _SKM_FL;
