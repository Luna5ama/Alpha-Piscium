                (response.x - response.y) + (response.z - response.y) / 11.0,
                ((response.x - response.z) + (response.y - response.z)) / 9.0);
}
// Combine the inverse cone response and the neutral tone curve in odds space.
void _sk_section(float r, out float neutral, out float w) {
    const float gray = .18 * _SKM_WHITE / _SKM_PEAK;
    const float exponent = 1. / (1. - gray);
    const float scale = gray / (1. - gray) * pow(27.13, exponent / .42) * pow(1. / (.18 * _SKM_FL), exponent);
    float odds = scale * pow(r / (400. - r), exponent / .42);
    float v = odds / (1. + odds);
    neutral = _SKM_PEAK * v;
    float shoulder = max((v - gray) / (1. - gray), 0.);
    w = shoulder * shoulder;
}
vec2 _sk_direction(float h) {
